<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_bmaglass" model="ir.ui.view">
        <field name="name">payment.provider.form.bmaglass</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="bmaglass_api_key" password="True"
                       invisible="code != 'bmaglass'"/>
                <field name="bmaglass_webhook_id"
                       invisible="code != 'bmaglass'"/>
                <field name="bmaglass_webhook_secret" password="True"
                       invisible="code != 'bmaglass'"/>
                <div invisible="code != 'bmaglass'">
                    <button name="action_bmaglass_test_connection" type="object"
                            class="btn-secondary" string="Test connection"/>
                    <button name="action_bmaglass_register_webhook" type="object"
                            class="btn-secondary" string="Register webhook"/>
                    <p class="text-muted">
                        Test connection reads your BMaGlass wallets with the key above.
                        Register webhook points BMaGlass at this instance
                        (/payment/bmaglass/webhook) and stores the signing secret.
                        Enabling this provider requires a live key — BMaGlass test
                        keys are read-only by design (no test-mode ledger).
                    </p>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
