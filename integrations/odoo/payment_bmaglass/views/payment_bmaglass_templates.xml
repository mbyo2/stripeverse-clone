<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Redirect form: sends the buyer to the hosted BMaGlass payment
         page (rendering values carry api_url = the payment link URL). -->
    <template id="redirect_form">
        <form action="" method="get">
            <input type="hidden" name="api_url" t-att-value="api_url"/>
        </form>
        <script>
            (function () {
                var url = document.querySelector('input[name="api_url"]').value;
                if (url) { window.location.href = url; }
            })();
        </script>
    </template>
</odoo>
