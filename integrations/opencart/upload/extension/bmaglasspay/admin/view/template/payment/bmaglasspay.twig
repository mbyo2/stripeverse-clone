<div class="card">
  <div class="card-header"><i class="fa-solid fa-wallet"></i> {{ heading_title }}</div>
  <div class="card-body">
    <form id="form-payment" action="{{ action }}" method="post" data-oc-toggle="ajax">
      <div class="row mb-3">
        <label class="col-sm-2 col-form-label">{{ entry_webhook_url }}</label>
        <div class="col-sm-10"><input type="text" readonly value="{{ webhook_url }}" class="form-control"/><div class="form-text">{{ help_webhook_url }}</div></div>
      </div>
      <div class="row mb-3">
        <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
        <div class="col-sm-10">
          <select name="payment_bmaglasspay_status" class="form-select">
            <option value="1"{% if payment_bmaglasspay_status %} selected{% endif %}>{{ text_enabled }}</option>
            <option value="0"{% if not payment_bmaglasspay_status %} selected{% endif %}>{{ text_disabled }}</option>
          </select>
        </div>
      </div>
      <div class="row mb-3">
        <label class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
        <div class="col-sm-10"><input type="text" name="payment_bmaglasspay_api_key" value="{{ payment_bmaglasspay_api_key }}" class="form-control"/><div class="form-text">{{ help_api_key }}</div></div>
      </div>
      <div class="row mb-3">
        <label class="col-sm-2 col-form-label">{{ entry_webhook_secret }}</label>
        <div class="col-sm-10"><input type="text" name="payment_bmaglasspay_webhook_secret" value="{{ payment_bmaglasspay_webhook_secret }}" class="form-control"/><div class="form-text">{{ help_webhook_secret }}</div></div>
      </div>
      <div class="row mb-3">
        <label class="col-sm-2 col-form-label">{{ entry_order_status }}</label>
        <div class="col-sm-10">
          <select name="payment_bmaglasspay_order_status_id" class="form-select">
            {% for os in order_statuses %}<option value="{{ os.order_status_id }}"{% if os.order_status_id == payment_bmaglasspay_order_status_id %} selected{% endif %}>{{ os.name }}</option>{% endfor %}
          </select>
        </div>
      </div>
      <div class="row mb-3">
        <label class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
        <div class="col-sm-10"><input type="text" name="payment_bmaglasspay_sort_order" value="{{ payment_bmaglasspay_sort_order }}" class="form-control"/></div>
      </div>
      <button type="button" class="btn btn-secondary" onclick="testConnection()">{{ button_test ?? 'Test connection' }}</button>
    </form>
  </div>
</div>
<script>
function testConnection() {
  fetch('{{ test_action }}'.replace(/&amp;/g, '&'), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(r => r.json())
    .then(j => alert(j.success || j.error || 'No response'))
    .catch(() => alert('Connection test failed to run.'));
}
</script>
