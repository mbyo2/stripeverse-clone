<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment" translate="label" sortOrder="400" showInDefault="1">
            <group id="bmaglasspay" translate="label" sortOrder="50" showInDefault="1">
                <label>BMaGlass Pay</label>
                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Title</label>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="30" showInDefault="1">
                    <label>BMaGlass API key</label>
                    <comment>From BMaGlass Pay (Business settings or API page). Test keys (bmp_test_...) are read-only — checkout requires a live key (bmp_live_...). Save, then use the store's connectivity: the method only appears when the key can read your wallets.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="webhook_secret" translate="label comment" type="obscure" sortOrder="40" showInDefault="1">
                    <label>Webhook signing secret</label>
                    <comment>Register the webhook URL https://YOUR-STORE/bmaglass/webhook in the BMaGlass Pay developer page (or via the API) and paste the secret shown once. Settlement is additionally confirmed by API reconciliation, so orders complete even if a delivery is missed.</comment>
                </field>
                <field id="order_status" translate="label" type="select" sortOrder="50" showInDefault="1">
                    <label>New order status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\Pendingpayment</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
